# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Optional, defaults to openai/gpt-oss-120b. Check console.groq.com/docs/deprecations
# if the chat starts failing: Groq retires models a few times a year.
GROQ_MODEL=

# Supabase project (Settings -> API)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by `npm run ingest` to write embeddings. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
